<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InfoFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvInfoNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/info_number"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvInfoType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/info_type"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvInfoAbility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/info_ability"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvInfoForms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/info_forms"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
